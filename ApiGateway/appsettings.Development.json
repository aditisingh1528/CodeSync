{
  /*
    In Development, show more logging from Ocelot and the gateway
    so you can trace exactly how requests are being routed.
  */
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Ocelot": "Information",
      "ApiGateway": "Debug"
    }
  }
}
