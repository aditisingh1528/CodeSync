{
  /*
  ======================================================================
    API GATEWAY — appsettings.json
  ======================================================================
    IMPORTANT:  Jwt:Key, Jwt:Issuer and Jwt:Audience here MUST match
    the same values in AuthService/appsettings.json exactly.
    If they differ, tokens issued by AuthService will fail to validate
    at the gateway and every secured route will return 401.
  ======================================================================
  */

  "Jwt": {
    "Key": "ThisIsASecretKeyForJwtTokenGeneration@AuthService2024!",
    "Issuer": "AuthService",
    "Audience": "AuthServiceClients"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      /*
        Ocelot logs a lot of debug noise by default.
        Set to "Warning" to keep the console readable.
        Change to "Debug" if you need to trace Ocelot's routing decisions.
      */
      "Ocelot": "Warning"
    }
  },

  "AllowedHosts": "*"
}
