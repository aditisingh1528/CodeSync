{
  "ConnectionStrings": {
    /*
      ProjectDB is a SEPARATE database from AuthDB.
      Microservices own their own data — never share databases.
      Change the Server value to match your SQL Server instance name.
    */
    "ProjectDB": "Server=LAPTOP-64SKNE7A\\SQLEXPRESS01;Database=ProjectDB;Trusted_Connection=True;TrustServerCertificate=True;",

    /*
      Redis is used for caching project responses.
      Default port is 6379. If you run Redis via Docker:
        docker run -d -p 6379:6379 redis
      Then this value stays as "localhost:6379"
    */
    "Redis": "localhost:6379,abortConnect=false"
  },

  /*
    JWT config MUST match AuthService appsettings.json exactly.
    ProjectService does NOT issue tokens — only validates them.
    Key, Issuer, Audience all must be identical.
  */
  "Jwt": {
    "Key":      "ThisIsASecretKeyForJwtTokenGeneration@AuthService2024!",
    "Issuer":   "AuthService",
    "Audience": "AuthServiceClients"
  },

  /*
    Redis Cache Settings
    SlidingExpiration  — resets timer every time the key is accessed.
    AbsoluteExpiration — hard limit regardless of access. Cache always
                         expires after this, even if frequently accessed.
    These two together prevent stale data from living forever.
  */
  "CacheSettings": {
    "SlidingExpirationSeconds":  120,
    "AbsoluteExpirationSeconds": 600
  },

  "Logging": {
    "LogLevel": {
      "Default":             "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}
