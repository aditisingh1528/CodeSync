{
  "ConnectionStrings": {
    /*
      ProjectDB is a SEPARATE database from AuthDB.
      Microservices own their own data — never share databases.
      Change the Server value to match your SQL Server instance name.
    */
    "ProjectDB": "Server=LAPTOP-64SKNE7A\\SQLEXPRESS01;Database=ProjectDB;Trusted_Connection=True;TrustServerCertificate=True;"
  },

  /*
    JWT config MUST match AuthService appsettings.json exactly.
    ProjectService does NOT issue tokens — only validates them.
    Key, Issuer, Audience all must be identical.
  */
  "Jwt": {
    "Key":      "ThisIsASecretKeyForJwtTokenGeneration@AuthService2024!",
    "Issuer":   "AuthService",
    "Audience": "AuthServiceClients"
  },

  "Logging": {
    "LogLevel": {
      "Default":             "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}
